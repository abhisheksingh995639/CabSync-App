# =============================================================================
# CabSync Android App — .gitignore
# =============================================================================

# =============================================================================
# SECURITY — NEVER COMMIT THESE
# =============================================================================

# Firebase config (contains API keys and project credentials)
google-services.json

# Android signing keystores
*.jks
*.keystore
keystore.properties

# Environment files (local secrets)
.env
.env.local
.env.*.local
# Allow the example file to be committed
!.env.example

# Firebase Admin SDK service account keys
*-firebase-adminsdk-*.json
service-account*.json

# =============================================================================
# GRADLE BUILD OUTPUTS & CACHES
# =============================================================================

# Build outputs
build/
app/build/
*/build/

# Gradle caches & wrapper files (keep gradlew scripts, ignore downloaded caches)
.gradle/
gradle/wrapper/gradle-wrapper.jar

# Gradle daemon logs
gradle-app.setting

# =============================================================================
# ANDROID STUDIO / IntelliJ IDEA
# =============================================================================

# IDE project files (auto-generated; each developer has their own)
.idea/
*.iml
*.ipr
*.iws

# Android Studio captures folder
captures/

# Profiling outputs
*.hprof

# =============================================================================
# ANDROID SDK & TOOLING
# =============================================================================

# Local Android SDK path (machine-specific)
local.properties

# Proguard mapping files (generated during release builds)
# Uncomment below if you don't need to keep mapping files for crash reporting
# app/src/main/proguard-mappings/

# =============================================================================
# KOTLIN / JVM
# =============================================================================

# Kotlin metadata
.kotlin/

# =============================================================================
# BUILD ARTIFACTS & REPORTS
# =============================================================================

# Generated APKs and AABs
*.apk
*.aab

# Build error logs (project-specific debug files)
build_error.txt
build_error_2.txt
build_output.txt

# Test reports
app/build/reports/

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================

*.log
*.tmp
*.temp
*.swp
*.swo

# =============================================================================
# NODE (if any tooling scripts are present)
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
